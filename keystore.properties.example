# Copy this file to keystore.properties (project root) and fill in real values.
# keystore.properties is gitignored — it must never be committed.
#
# Generate an upload keystore (run from the project root) with:
#   keytool -genkeypair -v -keystore charades-upload-key.jks -alias charades -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the app/ module directory, so a keystore kept at the
# project root (as in the command above) is referenced as ../<filename>.jks.

storeFile=../charades-upload-key.jks
storePassword=CHANGE_ME
keyAlias=charades
keyPassword=CHANGE_ME
